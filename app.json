{
  "expo": {
    "name": "JobReel",
    "slug": "jobreel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "jobreel",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jobreel.app",
      "buildNumber": "22",
      "minimumOsVersion": "15.1",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçmek için galeri erişimine izin verin.",
        "CFBundleLocalizations": [
          "tr",
          "en"
        ],
        "CFBundleDevelopmentRegion": "tr"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d0d14"
      },
      "package": "com.jobreel.app",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0d0d14",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçmek için galeri erişimine izin verin.",
          "cameraPermission": false
        }
      ],
      "expo-document-picker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C63FF",
          "sounds": [],
          "iosDisplayInForeground": true,
          "notificationPermissionDescription": "İş alarmları ve yeni ilan bildirimleri almak için izin verin."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d8216ba-e91e-41c1-a445-006f0c027430"
      }
    },
    "owner": "dogankapikiran",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/8d8216ba-e91e-41c1-a445-006f0c027430"
    }
  }
}
