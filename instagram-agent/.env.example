# JobReel Instagram Agent - Environment Variables
# Bu dosyayı .env.example olarak commit et, .env olarak ASLA commit etme!

# ─── Anthropic Claude API ───────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── fal.ai (Görsel / Video Üretimi) ────────────────────────────────────────
# https://fal.ai/dashboard/keys
FAL_API_KEY=...

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# 1. @BotFather'a yaz → /newbot → token al
TELEGRAM_BOT_TOKEN=...

# 2. @userinfobot'a mesaj at → chat_id'ni öğren
# Grup kullanıyorsan: -100 ile başlar
TELEGRAM_CHAT_ID=...

# ─── Instagram Graph API ─────────────────────────────────────────────────────
# Kurulum:
# 1. Meta Developer Console → App oluştur
# 2. Instagram Basic Display veya Graph API ekle
# 3. Professional Instagram account bağla
# 4. Long-lived token al (60 gün geçerli, otomatik yenileme için cron ekle)
INSTAGRAM_ACCESS_TOKEN=...
INSTAGRAM_ACCOUNT_ID=...   # Instagram hesabının numerik ID'si

# ─── Pipeline Ayarları ───────────────────────────────────────────────────────
# 'image' veya 'reels' - workflow tarafından otomatik set edilir
POST_TYPE=image

# 'true' ise Instagram'a post ATMAZ, sadece içerik+görsel üretir
DRY_RUN=false
